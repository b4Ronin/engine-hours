import { getStore } from "@netlify/blobs";import imports from "../../comic-imports.json";const store=getStore({name:"comic-vault",consistency:"strong"});const j=(v:any,s=200)=>new Response(JSON.stringify(v),{status:s,headers:{"content-type":"application/json","cache-control":"no-store"}});const norm=(s:any)=>String(s||"").replace(/\D/g,"");function clean(x:any){return{certNumber:norm(x.certNumber),title:String(x.title||"Unknown").trim(),issue:String(x.issue||"").trim(),issueDate:String(x.issueDate||"").trim(),year:String(x.year||"").trim(),publisher:String(x.publisher||"").trim(),variant:String(x.variant||"").trim(),grade:String(x.grade||"").trim(),pageQuality:String(x.pageQuality||"").trim(),label:String(x.label||"").trim(),signature:String(x.signature||"").trim(),signedDate:String(x.signedDate||"").trim(),writer:String(x.writer||"").trim(),artist:String(x.artist||"").trim(),coverArtist:String(x.coverArtist||"").trim(),gradeDate:String(x.gradeDate||"").trim(),graderNotes:String(x.graderNotes||"").trim(),census:String(x.census||"").trim(),notes:String(x.notes||"").trim(),tags:Array.isArray(x.tags)?[...new Set(x.tags.map((t:any)=>String(t).trim()).filter(Boolean))]:[],dateAdded:String(x.dateAdded||new Date().toISOString())}}async function all(){let a:any[]=await store.get("collection.json",{type:"json"})||[],changed=false;for(const raw of (imports as any).comics||[]){let c=clean(raw);if(raw.imageBase64){let ik="comic-images/"+c.certNumber;let existing=await store.get(ik,{type:"blob"});if(!existing){let bytes=Uint8Array.from(atob(raw.imageBase64),(x)=>x.charCodeAt(0));await store.set(ik,new Blob([bytes],{type:"image/jpeg"}))}}let i=a.findIndex(x=>norm(x.certNumber)===c.certNumber);if(i<0){a.push(c);changed=true}else{let n={...a[i],...c,dateAdded:a[i].dateAdded||c.dateAdded};if(JSON.stringify(n)!==JSON.stringify(a[i])){a[i]=n;changed=true}}}if(changed)await store.setJSON("collection.json",a);return a.sort((a,b)=>a.title.localeCompare(b.title))}export default async(req:Request)=>{let u=new URL(req.url),parts=u.pathname.split("/").filter(Boolean),idx=parts.lastIndexOf("comics"),rest=idx>=0?parts.slice(idx+1):[];if(req.method==="GET"&&rest[0]==="image"&&rest[1]){let cert=norm(rest[1]),b=await store.get("comic-images/"+cert,{type:"blob"});return b?new Response(b,{headers:{"content-type":b.type||"image/jpeg","cache-control":"public,max-age=86400"}}):new Response("",{status:404})}if(req.method==="GET"){return j(await all())}let key=process.env.COMIC_VAULT_API_KEY||"",auth=req.headers.get("authorization")==="Bearer "+key;if(!key||!auth)return j({error:"Unauthorized"},401);if(req.method==="POST"&&rest[0]==="image"&&rest[1]){let cert=norm(rest[1]);if(!cert)return j({error:"Invalid certification"},400);let b=await req.blob();if(!b.size)return j({error:"Empty image"},400);await store.set("comic-images/"+cert,b);return j({ok:true,certNumber:cert})}if(req.method==="POST"){let c=clean(await req.json());if(!c.certNumber)return j({error:"Certification number required"},400);let a=await all();if(a.some(x=>norm(x.certNumber)===c.certNumber))return j({error:"Certification already exists"},409);a.push(c);await store.setJSON("collection.json",a);return j(c,201)}return j({error:"Method not allowed"},405)};